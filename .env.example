# box_agent 설정. CLI(로컬)와 docker compose 가 같이 읽는다. 실제 값은 .env 에(커밋하지 않음)

# LLM (없으면 규칙 기반 문장, 인용·반려 해석은 키워드만)
OPENAI_API_KEY=
# BOX_AGENT_LLM_MODEL=gpt-5.4-mini
# BOX_AGENT_LLM_FALLBACK_MODEL=

# 업무 데이터: Spring 내부 API. 토큰은 Spring(server/chagok/.env)의 INTERNAL_API_TOKEN 과 같은 값
#   로컬 CLI 용. compose 안에서는 AGENT_BUSINESS_API_URL(기본 http://backend:8080)을 쓴다
BUSINESS_API_URL=http://localhost:8080
INTERNAL_API_TOKEN=

# checkpointer·rag 벡터 검색용 DB (로컬 CLI 는 server/chagok/.env 의 DB_URL 을 읽는다)
DB_PASSWORD=postgres
# DB_HOST=postgres            # 온라인 공용 DB: 100.101.79.37
# DB_PORT=5432                # 온라인 공용 DB: 15432
# DB_NAME=chagok

# compose 가 합류할 docker network (compose.web.yaml: chagok-web_default, 로컬 인프라 compose.yaml: chagok_default)
AGENT_NETWORK=chagok-web_default

# LangSmith trace (선택)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=box-agent
