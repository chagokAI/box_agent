{
  "mcpServers": {
    "business": {
      "command": "python",
      "args": [
        "mcp_servers/business_mcp.py"
      ],
      "env": {
        "BUSINESS_API_URL": "http://localhost:8080",
        "INTERNAL_API_TOKEN": "<server/chagok/.env 와 같은 값>",
        "SHIPMENT_EVENT_STATUSES": ""
      }
    },
    "rag": {
      "command": "python",
      "args": [
        "mcp_servers/rag_mcp.py"
      ],
      "env": {
        "DB_URL": "jdbc:postgresql://localhost:15432/chagok",
        "DB_USERNAME": "postgres",
        "DB_PASSWORD": "postgres"
      }
    },
    "business-http": {
      "url": "http://127.0.0.1:9101/mcp",
      "transport": "http"
    },
    "rag-http": {
      "url": "http://127.0.0.1:9102/mcp",
      "transport": "http"
    }
  }
}
